# Melhor Envio — entregas fora de Curitiba/RMC (ver src/shipping/MELHOR_ENVIO.md)
# Sandbox: https://sandbox.melhorenvio.com.br · Produção: https://melhorenvio.com.br
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
# Modo app OAuth (produção): autorizar 1x em GET /melhor-envio/oauth/start?key=$MELHOR_ENVIO_SETUP_KEY
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=          # também valida o x-me-signature do webhook
MELHOR_ENVIO_REDIRECT_URI=https://SEU-BACKEND/melhor-envio/oauth/callback
MELHOR_ENVIO_SETUP_KEY=              # segredo qualquer, longo
# Alternativa para teste rápido: token gerado no painel (sem webhook). Se preenchido, ignora o OAuth.
MELHOR_ENVIO_ACCESS_TOKEN=
MELHOR_ENVIO_USER_AGENT="Hema App (email-tecnico@dominio)"
MELHOR_ENVIO_SERVICES=1,2            # ids dos serviços (1 PAC, 2 SEDEX); vazio = os habilitados na conta
MELHOR_ENVIO_UNIT_WEIGHT_G=500       # peso de item por unidade quando o nome não diz (ex.: "1kg")
MELHOR_ENVIO_NON_COMMERCIAL=false    # true = declaração de conteúdo; false = exige chave da NF-e por pedido
# Remetente (loja)
MELHOR_ENVIO_FROM_NAME=Hema Cereais
MELHOR_ENVIO_FROM_PHONE=
MELHOR_ENVIO_FROM_EMAIL=
MELHOR_ENVIO_FROM_DOCUMENT=          # CNPJ
MELHOR_ENVIO_FROM_STATE_REGISTER=    # IE
MELHOR_ENVIO_FROM_CNAE=
MELHOR_ENVIO_FROM_ADDRESS=R. São José dos Pinhais
MELHOR_ENVIO_FROM_NUMBER=187
MELHOR_ENVIO_FROM_COMPLEMENT=
MELHOR_ENVIO_FROM_DISTRICT=Sítio Cercado
MELHOR_ENVIO_FROM_CITY=Curitiba
MELHOR_ENVIO_FROM_STATE=PR
MELHOR_ENVIO_FROM_POSTAL_CODE=81910010
