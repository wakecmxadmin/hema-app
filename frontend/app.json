{
  "expo": {
    "name": "Hema Cereais",
    "slug": "hemaapp",
    "owner": "codificaai",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hemaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/13ba697c-dc80-4712-86f4-b18d784d8d38"
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D91A21"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pro.codificaai.hema",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "A Hema Cereais precisa acessar sua galeria para que você possa personalizar a foto do seu perfil.",
        "NSCameraUsageDescription": "A Hema Cereais usa a câmera para que você possa tirar uma foto de perfil diretamente pelo app."
      }
    },
    "android": {
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#D91A21"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "pro.codificaai.hema"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D91A21"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13ba697c-dc80-4712-86f4-b18d784d8d38"
      }
    }
  }
}
